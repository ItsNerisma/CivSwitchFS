        "dist/**",
        "llm/**",
        "logs/**",
        "node_modules/**",
        "persist/**",
        "test-payloads/**"
    ],
    "overrides": [
        {
            "files": [
                "tools/**/*.js",
                "tools/**/*.mjs"
            ],
            "env": {
                "node": true
            }
        },
        {
            "files": [
                "src/core/**/*.js"
            ],
            "rules": {
                "no-unused-vars": "off"
            }
        }
    ],
    "rules": {
        "curly": "error",
        "no-inline-comments": "off",
        "no-undef": "error",
        "no-unused-vars": "warn",
        "no-var": "off",
        "unicorn/no-new-array": "off"
    }
