{
  "name": "civswitchfs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CivSwitch FS privilege-escalation research payload",
  "scripts": {
    "build": "node tools/build.mjs",
    "persist": "node tools/persist.mjs",
    "send": "node tools/send.mjs",
    "check": "npm run lint && npm run format:check && node tools/check.mjs",
    "example:user-storage": "node tools/send.mjs --entry examples/user-storage.mjs",
    "lint": "node tools/lint-globals.mjs --check && oxlint --deny-warnings && node tools/lint-predicates.mjs",
    "lint:fix": "oxlint --fix && npm run format",
    "lint:globals": "node tools/lint-globals.mjs",
    "format": "eslint --fix",
    "format:check": "eslint"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "oxlint": "^1.95.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "license": "MIT"
}
